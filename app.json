{
  "expo": {
    "name": "BeerCellar",
    "slug": "BeerCellar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beercellar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BeerCellar utilise la caméra pour scanner les codes-barres et photographier les bières.",
        "NSPhotoLibraryUsageDescription": "BeerCellar accède à vos photos pour ajouter une image à vos bières."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0a00"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.beercellar.app",
      "versionCode": 14,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BeerCellar utilise la caméra pour scanner les codes-barres et photographier les bières."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BeerCellar accède à vos photos pour ajouter une image à vos bières."
        }
      ],
      "expo-font"
    ],
    "scheme": "beercellar",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9912b827-141c-4c0b-9fb7-22be5caa0ba1"
      }
    },
    "owner": "nzangel"
  }
}
